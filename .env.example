# Server Configuration
PORT=8002
HOST=127.0.0.1
DEBUG=True

# Database Configuration (SQLite default; PostgreSQL compatible)
DATABASE_URL=sqlite:///./tickets.db

# Agent Policy & Confidence Threshold
CONFIDENCE_THRESHOLD=0.80

# LLM Configuration
# Set MOCK_LLM=true for local deterministic execution; false when LLM_API_KEY is supplied
MOCK_LLM=true
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
